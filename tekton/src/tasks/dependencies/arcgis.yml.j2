---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: mas-devops-arcgis
spec:
  params:
    {{ lookup('template', task_src_dir ~ '/common/cli-params.yml.j2') | indent(4) }}

    # MAS Details
    - name: mas_instance_id
      type: string
      description: Instance ID

    # Application - Operator
    - name: mas_arcgis_channel
      type: string
      description: Catalog channel for the application operator subscription

    # Application - Operand
    - name: mas_app_bindings_jdbc
      default: ""
      type: string
    - name: mas_app_plan
      type: string
      description: Application installation plan
      default: ""

    # Custom Label Support
    - name: custom_labels
      type: string
      description: Optional MAS custom labels, comma separated list of key=value pairs
      default: ""

    # ArcGIS Organization Configuration
    - name: arcgis_configure_org
      default: "false"
      type: string
    - name: arcgis_admin_username
      default: ""
      type: string
    - name: arcgis_admin_password
      default: ""
      type: string
    - name: arcgis_admin_email
      default: ""
      type: string
    - name: arcgis_admin_first_name
      default: ""
      type: string
    - name: arcgis_admin_last_name
      default: ""
      type: string
    - name: arcgis_arch_profile
      default: "development"
      type: string
    - name: arcgis_license_file
      default: ""
      type: string
    - name: arcgis_storage_class
      default: ""
      type: string

  stepTemplate:
    env:
      {{ lookup('template', task_src_dir ~ '/common/cli-env.yml.j2') | indent(6) }}

      # MAS Details
      - name: MAS_INSTANCE_ID
        value: $(params.mas_instance_id)

      # Application - Operator
      - name: MAS_ARCGIS_CHANNEL
        value: $(params.mas_arcgis_channel)

      # Custom Label Support
      - name: CUSTOM_LABELS
        value: $(params.custom_labels)

      # ArcGIS Organization Configuration
      - name: ARCGIS_CONFIGURE_ORG
        value: $(params.arcgis_configure_org)
      - name: ARCGIS_ADMIN_USERNAME
        value: $(params.arcgis_admin_username)
      - name: ARCGIS_ADMIN_PASSWORD
        value: $(params.arcgis_admin_password)
      - name: ARCGIS_ADMIN_EMAIL
        value: $(params.arcgis_admin_email)
      - name: ARCGIS_ADMIN_FIRST_NAME
        value: $(params.arcgis_admin_first_name)
      - name: ARCGIS_ADMIN_LAST_NAME
        value: $(params.arcgis_admin_last_name)
      - name: ARCGIS_ARCH_PROFILE
        value: $(params.arcgis_arch_profile)
      - name: ARCGIS_LICENSE_FILE
        value: $(params.arcgis_license_file)
      - name: ARCGIS_STORAGE_CLASS
        value: $(params.arcgis_storage_class)

  steps:
    - name: arcgis
      command:
        - /opt/app-root/src/run-role.sh
        - arcgis
      image: "quay.io/ibmmas/cli:latest"
      imagePullPolicy: $(params.image_pull_policy)
