- name: ocs
  timeout: "0"
  params:
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/cli-params.yml.j2') | indent(4) }}
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/registry-secret-param.yml.j2') | indent(4) }}
    - name: devops_suite_name
      value: dependencies-ocs

  taskRef:
    kind: Task
    name: mas-devops-ocs

  # Only install Ceph (ODF) if requested. The ocs role skips the install if a StorageCluster is already Ready
  when:
    - input: "$(params.install_ceph)"
      operator: in
      values: ["true", "True"]
  workspaces:
    - name: configs
      workspace: shared-configs
