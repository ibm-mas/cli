/* ==========================================================================
   MAS CLI TUI — application stylesheet
   All widget styles are consolidated here so no Python file contains
   inline CSS strings.  App-level rules (TextualShell) have higher
   specificity than widget DEFAULT_CSS and reliably override Textual's
   built-in Header/Footer colours.
   ========================================================================== */

/* ---------- Header / Footer overrides ------------------------------------- */

Header, HeaderIcon, HeaderClockSpace, HeaderClock {
    background: $background;
}

/* Prevent the header from expanding when clicked. */
Header.-tall {
    height: 1;
}

Footer, FooterKey {
    background: $background;
}

/* ---------- TextualShell layout ------------------------------------------- */

TextualShell {
    layout: vertical;
}

#main-horizontal {
    height: 1fr;
}

/* Fixed width rather than a percentage: predictable at any terminal size
   (25% is 20 chars at 80 cols — headings wrap — and 50 chars at 200 cols). */
#sidebar {
    width: 34;
    height: 100%;
    border-right: solid $primary-darken-3;
    padding: 1;
}

#step-content {
    width: 1fr;
    height: 100%;
}

/* Responsive: below 100 columns (the Screen.-narrow class is applied by
   TextualShell.HORIZONTAL_BREAKPOINTS) the sidebar is hidden so the
   content area keeps a usable width. */
Screen.-narrow #sidebar {
    display: none;
}

/* ---------- Sidebar ListView — strip all built-in highlighting ------------- */

#step-list,
#step-list:focus,
#step-list:focus-within {
    background: $background;
}

#step-list > ListItem,
#step-list > ListItem:hover,
#step-list > ListItem.--highlight,
#step-list:focus > ListItem.--highlight,
#step-list:focus-within > ListItem.--highlight {
    background: $background;
}

/* ---------- Sidebar step states ------------------------------------------- */

.step-active {
    color: $accent;
    text-style: bold;
}

.step-completed {
    color: $success;
}

.step-skipped {
    color: $text-muted;
}

/* ---------- Shared field / description styles ----------------------------- */

/* Text hierarchy: step headings are the only bold full-contrast text;
   descriptions are muted; field labels keep normal contrast so input
   values (full contrast) stand out against them. */
.step-heading {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
}

.description-para {
    color: $text-muted;
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

/* ---------- Shared screen layout (phase 3.1) ------------------------------- */

/* Scrollable content area inside a step panel.  Every screen's scrollable
   content carries this class so the gutter is identical between steps —
   it previously varied (0, 1 or 1 2 depending on the screen), which read
   as the content jumping sideways when moving between steps. */
.content-scroll {
    height: 1fr;
    padding: 1 2;
}

/* Fixed-height action bar pinned below the scrollable content.  The height
   is fixed (border-top 1 + status row 1 + gap 1 + buttons 3 = 6) so the
   content / action-bar boundary sits on the same row on every screen, and
   nothing revealed mid-flow can shift the layout: the status row keeps
   its height whether it holds guidance text, an error, or nothing, and
   buttons hidden with display:none appear without moving anything.
   Vertical padding is deliberately 0 — the border-top already separates
   the bar from the content, and the buttons belong flush to the panel's
   bottom edge. */
.action-bar {
    height: 6;
    padding: 0 2;
    border-top: solid $panel-lighten-2;
}

/* Reserved status row: one line of muted guidance, or the error styling
   via .action-status--error.  Long messages are truncated with an
   ellipsis rather than wrapped so the row can never grow. */
.action-status {
    height: 1;
    margin-bottom: 1;
    width: 100%;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.action-status--error {
    color: $error;
    text-style: bold;
}

/* Status rows that host a leading busy spinner (the connect screen): the
   geometry stays on the row, the text treatment applies to its Label. */
.action-status > Label {
    width: 1fr;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.action-status > .action-status--error {
    color: $error;
    text-style: bold;
}

.action-buttons {
    height: 3;
}

/* ---------- ActionOverlay ------------------------------------------------- */

ActionOverlay {
    align: center middle;
}

#action-dialog {
    width: 70%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: round $primary-darken-2;
    padding: 1 2;
}

#action-log {
    height: 10;
    border: solid $primary-darken-3;
}

#btn-dismiss {
    display: none;
    margin-top: 1;
}

/* ---------- ConnectStepScreen --------------------------------------------- */
/* Root is a Vertical: a .content-scroll area (heading + ContentSwitcher)
   with the shared .action-bar below (status row + Yes/No/Connect buttons —
   which buttons are visible follows the active sub-screen). */

#connect-switcher {
    height: 1fr;
}

#connect-reuse, #connect-new {
    height: 100%;
    padding: 0;
}

.connect-heading {
    text-style: bold;
    margin-bottom: 1;
}

.connect-url {
    color: $accent;
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

.connect-field-label {
    margin-top: 1;
}

/* Busy spinner leading the action bar's status row while a connect worker
   runs — hidden otherwise.  Follows the same class-toggle pattern as the
   dep screen's button reveals. */
#connect-busy-spinner {
    display: none;
    width: 3;
    height: 1;
    margin-right: 1;
}

#connect-busy-spinner.connect-busy--visible {
    display: block;
}

/* ---------- AutoRunScreen ------------------------------------------------- */

AutoRunScreen {
    height: 100%;
}

/* #dep-content carries .content-scroll (padding 1 2 + height 1fr). */

#dep-step-list {
    height: auto;
    border: solid $primary-darken-3;
    margin-top: 1;
    background: $background;
}

#dep-step-list > ListItem,
#dep-step-list > ListItem:hover,
#dep-step-list > ListItem.--highlight,
#dep-step-list:focus > ListItem.--highlight,
#dep-step-list:focus-within > ListItem.--highlight {
    background: $background;
    height: auto;
}

#dep-step-list > ListItem > Label {
    width: 100%;
    text-wrap: wrap;
}

/* #dep-footer / #dep-prompt / #dep-buttons carry the shared action-bar /
   action-status / action-buttons classes — see the shared layout block. */

#btn-next-dep {
    display: none;
}

#btn-next-dep.dep-ready {
    display: block;
}

#btn-quit-dep {
    display: none;
}

#btn-quit-dep.dep-failed {
    display: block;
}

/* ---------- LaunchScreen -------------------------------------------------- */

LaunchScreen {
    height: 100%;
}

/* #launch-content carries .content-scroll; #launch-footer / #launch-prompt /
   #launch-buttons carry the shared action-bar classes. */

#launch-step-list {
    height: auto;
    border: solid $primary-darken-3;
    margin-top: 1;
    background: $background;
}

#launch-step-list > ListItem,
#launch-step-list > ListItem:hover,
#launch-step-list > ListItem.--highlight,
#launch-step-list:focus > ListItem.--highlight,
#launch-step-list:focus-within > ListItem.--highlight {
    background: $background;
    height: auto;
}

#launch-step-list > ListItem > Label {
    width: 100%;
    text-wrap: wrap;
}

#pipeline-url {
    margin-top: 1;
    width: 100%;
    text-wrap: wrap;
    color: $accent;
}

/* ---------- Shared step-error state --------------------------------------- */

.step-error {
    color: $error;
    text-style: bold;
}

/* ---------- ReviewScreen -------------------------------------------------- */

ReviewScreen {
    height: 100%;
}

/* #review-content carries .content-scroll; #review-footer / #review-prompt /
   #review-buttons carry the shared action-bar classes. */

#review-content Markdown {
    margin-top: 0;
    /* The Markdown widget's own 0 2 padding is stripped so the review text
       sits at the same gutter as every other screen's content (the
       .content-scroll padding already provides the 1 2). */
    padding: 0;
}

/* MarkdownH2 inherits margin: 2 0 1 0 from MarkdownHeader — strip the
   top margin on the first heading so there is no blank space above it. */
#review-content MarkdownH2:first-of-type {
    margin-top: 0;
}

/* ---------- StepScreen ---------------------------------------------------- */

StepScreen {
    height: 100%;
}

/* Read-only context panel shown between the description and the fields
   (e.g. the installed catalog on the update choose-catalog step).  Mirrors
   the .confirm-section panel style. */
.step-context {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    padding: 1;
    border: round $panel-lighten-2;
}

.context-row {
    height: auto;
}

.context-label {
    width: 30;
    color: $text-muted;
}

.context-value {
    width: 1fr;
    text-wrap: wrap;
    color: $accent;
}

/* ---------- ConfirmUpgradesScreen ---------------------------------------- */

ConfirmUpgradesScreen {
    height: 100%;
}

.confirm-section {
    margin-top: 1;
    margin-bottom: 1;
    padding: 1;
    border: round $panel-lighten-2;
}

.confirm-section-heading {
    text-style: bold;
    margin-bottom: 1;
}

.confirm-section-para {
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

.confirm-checkbox {
    margin-top: 1;
}

/* ---------- ParamsOverlay ------------------------------------------------- */

ParamsOverlay {
    align: center middle;
}

#params-dialog {
    width: 70%;
    max-width: 100;
    height: 80%;
    background: $surface;
    border: round $primary-darken-2;
    padding: 1 2;
}

#params-heading {
    text-style: bold;
    margin-bottom: 1;
}

#params-table {
    height: 1fr;
}

#btn-params-close {
    margin-top: 1;
}

/* ---------- TerminalTooSmallScreen ---------------------------------------- */

TerminalTooSmallScreen {
    align: center middle;
}

#size-notice-dialog {
    width: 44;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: $surface;
    border: round $warning;
    padding: 1 2;
    overflow: hidden;
}

.size-notice-heading {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

.size-notice-para {
    width: 100%;
    text-wrap: wrap;
    color: $text-muted;
}
