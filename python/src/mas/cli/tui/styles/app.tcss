/* ==========================================================================
   MAS CLI TUI — application stylesheet
   All widget styles are consolidated here so no Python file contains
   inline CSS strings.  App-level rules (TextualShell) have higher
   specificity than widget DEFAULT_CSS and reliably override Textual's
   built-in Header/Footer colours.
   ========================================================================== */

/* ---------- Header / Footer overrides ------------------------------------- */

Header, HeaderIcon, HeaderClockSpace, HeaderClock {
    background: $background;
}

/* Prevent the header from expanding when clicked. */
Header.-tall {
    height: 1;
}

Footer, FooterKey {
    background: $background;
}

/* ---------- TextualShell layout ------------------------------------------- */

TextualShell {
    layout: vertical;
}

#main-horizontal {
    height: 1fr;
}

/* Fixed width rather than a percentage: predictable at any terminal size
   (25% is 20 chars at 80 cols — headings wrap — and 50 chars at 200 cols). */
#sidebar {
    width: 34;
    height: 100%;
    border-right: solid $primary-darken-3;
    padding: 1;
}

#step-content {
    width: 1fr;
    height: 100%;
}

/* ---------- Sidebar ListView — strip all built-in highlighting ------------- */

#step-list,
#step-list:focus,
#step-list:focus-within {
    background: $background;
}

#step-list > ListItem,
#step-list > ListItem:hover,
#step-list > ListItem.--highlight,
#step-list:focus > ListItem.--highlight,
#step-list:focus-within > ListItem.--highlight {
    background: $background;
}

/* ---------- Sidebar step states ------------------------------------------- */

.step-active {
    color: $accent;
    text-style: bold;
}

.step-completed {
    color: $success;
}

.step-skipped {
    color: $text-muted;
}

/* ---------- Shared field / description styles ----------------------------- */

/* Text hierarchy: step headings are the only bold full-contrast text;
   descriptions are muted; field labels keep normal contrast so input
   values (full contrast) stand out against them. */
.step-heading {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
}

.description-para {
    color: $text-muted;
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

/* ---------- Validator error labels ---------------------------------------- */

.validator-error {
    display: none;
}

.validator-error--visible {
    display: block;
    color: $error;
    margin-top: 1;
    text-style: bold;
    width: 100%;
    text-wrap: wrap;
}

/* ---------- ActionOverlay ------------------------------------------------- */

ActionOverlay {
    align: center middle;
}

#action-dialog {
    width: 70%;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: round $primary-darken-2;
    padding: 1 2;
}

#action-log {
    height: 10;
    border: solid $primary-darken-3;
}

#btn-dismiss {
    display: none;
    margin-top: 1;
}

/* ---------- ConnectStepScreen --------------------------------------------- */

ConnectStepScreen {
    height: 100%;
    padding: 1;
}

#connect-switcher {
    height: 1fr;
}

#connect-reuse, #connect-new {
    height: 100%;
    padding: 0;
}

.connect-heading {
    text-style: bold;
    margin-bottom: 1;
}

.connect-url {
    color: $accent;
    margin-bottom: 1;
}

.connect-error {
    color: $error;
    margin-top: 1;
}

.connect-field-label {
    margin-top: 1;
}

#reuse-buttons {
    margin-top: 2;
    height: auto;
}

/* Busy indicator shown while the connect worker runs.  Follows the same
   class-toggle pattern as .dep-error / .dep-error--visible above. */
#connect-busy {
    display: none;
    height: auto;
    margin-top: 1;
}

#connect-busy.connect-busy--visible {
    display: block;
}

#connect-busy-spinner {
    width: 3;
    height: 1;
}

#connect-busy-label {
    margin-left: 1;
    color: $text-muted;
}

/* ---------- AutoRunScreen ------------------------------------------------- */

AutoRunScreen {
    height: 100%;
}

#dep-content {
    height: 1fr;
    padding: 1;
}

#dep-step-list {
    height: auto;
    border: solid $primary-darken-3;
    margin-top: 1;
    background: $background;
}

#dep-step-list > ListItem,
#dep-step-list > ListItem:hover,
#dep-step-list > ListItem.--highlight,
#dep-step-list:focus > ListItem.--highlight,
#dep-step-list:focus-within > ListItem.--highlight {
    background: $background;
    height: auto;
}

#dep-step-list > ListItem > Label {
    width: 100%;
    text-wrap: wrap;
}

#dep-footer {
    height: auto;
    padding: 1 2;
    border-top: solid $panel-lighten-2;
}

#dep-prompt {
    margin-bottom: 1;
    color: $text-muted;
}

#dep-buttons {
    height: auto;
}

#btn-next-dep {
    display: none;
}

#btn-next-dep.dep-ready {
    display: block;
}

#btn-quit-dep {
    display: none;
}

#btn-quit-dep.dep-failed {
    display: block;
}

.dep-error {
    display: none;
}

.dep-error--visible {
    display: block;
    color: $error;
    margin-bottom: 1;
    text-style: bold;
    width: 100%;
    text-wrap: wrap;
}

/* ---------- LaunchScreen -------------------------------------------------- */

LaunchScreen {
    height: 100%;
}

#launch-content {
    height: 1fr;
    padding: 1;
}

#launch-step-list {
    height: auto;
    border: solid $primary-darken-3;
    margin-top: 1;
    background: $background;
}

#launch-step-list > ListItem,
#launch-step-list > ListItem:hover,
#launch-step-list > ListItem.--highlight,
#launch-step-list:focus > ListItem.--highlight,
#launch-step-list:focus-within > ListItem.--highlight {
    background: $background;
    height: auto;
}

#launch-step-list > ListItem > Label {
    width: 100%;
    text-wrap: wrap;
}

#pipeline-url {
    margin-top: 1;
    width: 100%;
    text-wrap: wrap;
    color: $accent;
}

#launch-footer {
    height: auto;
    padding: 1 2;
    border-top: solid $panel-lighten-2;
}

#launch-prompt {
    margin-bottom: 1;
    color: $text-muted;
}

#launch-buttons {
    height: auto;
}

/* ---------- Shared step-error state --------------------------------------- */

.step-error {
    color: $error;
    text-style: bold;
}

/* ---------- ReviewScreen -------------------------------------------------- */

ReviewScreen {
    height: 100%;
    padding: 1;
}

#review-content {
    height: 1fr;
    padding: 0;
}

#review-content Markdown {
    margin-top: 0;
    padding-top: 0;
}

/* MarkdownH2 inherits margin: 2 0 1 0 from MarkdownHeader — strip the
   top margin on the first heading so there is no blank space above it. */
#review-content MarkdownH2:first-of-type {
    margin-top: 0;
}

#review-footer {
    height: auto;
    padding: 1 2;
    border-top: solid $panel-lighten-2;
}

#review-prompt {
    margin-bottom: 1;
    color: $text-muted;
}

#review-buttons {
    height: auto;
}

/* ---------- StepScreen ---------------------------------------------------- */

StepScreen {
    height: 100%;
    padding: 1 2;
}

/* Read-only context panel shown between the description and the fields
   (e.g. the installed catalog on the update choose-catalog step).  Mirrors
   the .confirm-section panel style. */
.step-context {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    padding: 1;
    border: round $panel-lighten-2;
}

.context-row {
    height: auto;
}

.context-label {
    width: 30;
    color: $text-muted;
}

.context-value {
    width: 1fr;
    text-wrap: wrap;
    color: $accent;
}

/* ---------- ConfirmUpgradesScreen ---------------------------------------- */

ConfirmUpgradesScreen {
    height: 100%;
    padding: 1 2;
}

.confirm-section {
    margin-top: 1;
    margin-bottom: 1;
    padding: 1;
    border: round $panel-lighten-2;
}

.confirm-section-heading {
    text-style: bold;
    margin-bottom: 1;
}

.confirm-section-para {
    margin-bottom: 1;
    width: 100%;
    text-wrap: wrap;
}

.confirm-checkbox {
    margin-top: 1;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
}

/* ---------- ParamsOverlay ------------------------------------------------- */

ParamsOverlay {
    align: center middle;
}

#params-dialog {
    width: 70%;
    height: 80%;
    background: $surface;
    border: round $primary-darken-2;
    padding: 1 2;
}

#params-heading {
    text-style: bold;
    margin-bottom: 1;
}

#params-table {
    height: 1fr;
}

#btn-params-close {
    margin-top: 1;
}
