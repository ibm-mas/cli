merge-key: "{{ ACCOUNT_ID }}/{{ CLUSTER_ID }}/{{ MAS_INSTANCE_ID }}"

ibm_mas_suite:
  cert_manager_namespace: "{{ CERT_MANAGER_NAMESPACE }}"
  ibm_entitlement_key: "<path:{{ SECRETS_PATH }}:{{ SECRET_KEY_IBM_ENTITLEMENT }}>"
  domain: "{{ DOMAIN }}"
  mas_feature_usage: "{{ MAS_FEATURE_USAGE }}"
  mas_deployment_progression: "{{ MAS_DEPLOYMENT_PROGRESSION }}"
  mas_usability_metrics: "{{ MAS_USABILITY_METRICS }}"

{%- if DNS_PROVIDER is defined and DNS_PROVIDER !='' %}
  # suite dns
  dns_provider: "{{ DNS_PROVIDER }}"
  mas_workspace_id: "{{ MAS_WORKSPACE_ID }}"
  mas_config_dir: "{{ MAS_CONFIG_DIR }}"
  mas_domain: "{{ MAS_DOMAIN }}"
  ocp_cluster_domain: "{{ OCP_CLUSTER_DOMAIN }}"
{%- endif %}


{%- if DNS_PROVIDER is defined and DNS_PROVIDER == 'cis' %}
  cis_mas_domain: "{{ CIS_MAS_DOMAIN }}"
  cis_subdomain: "{{ CIS_SUBDOMAIN }}"
  cis_email: "{{ CIS_EMAIL }}"
  cis_crn: "{{ CIS_CRN }}"
  cis_apikey: "<path:{{ SECRETS_PATH }}:{{ SECRET_KEY_IBM_APIKEY }}>"
  cis_enhanced_security: "{{ CIS_ENHANCED_SECURITY }}"
  cis_proxy: "{{ CIS_PROXY }}"
  cis_waf: "{{ CIS_WAF }}"
  cis_service_name: "{{ CIS_SERVICE_NAME }}"
  update_dns_entries: "{{ UPDATE_DNS_ENTRIES }}"
  delete_wildcards: "{{ DELETE_WILDCARDS }}"
  override_edge_certs: "{{ OVERRIDE_EDGE_CERTS }}"
{%- endif %}

  mas_channel: "{{ MAS_CHANNEL }}"
  mas_install_plan: "{{ MAS_INSTALL_PLAN }}"
  icr_cp: "{{ ICR_CP }}"
  icr_cp_open: "{{ ICR_CP_OPEN }}"

{% if MAS_MANUAL_CERT_MGMT == 'true' %}
  mas_manual_cert_mgmt: true
{% else %}
  mas_manual_cert_mgmt: false
{% endif %}
{%- if MAS_ROUTING_MODE is defined and MAS_ROUTING_MODE !='' %}
  routing_mode: "{{ MAS_ROUTING_MODE }}"
{%- endif %}
{%- if MAS_INGRESS_CONTROLLER_NAME is defined and MAS_INGRESS_CONTROLLER_NAME !='' %}
  ingress_controller_name: "{{ MAS_INGRESS_CONTROLLER_NAME }}"
{%- endif %}
{%- if MAS_ANNOTATIONS is defined and MAS_ANNOTATIONS !='' %}
  mas_annotations:
    {{ MAS_ANNOTATIONS | indent(4) }}
{%- endif %}
{%- if MAS_LABELS is defined and MAS_LABELS !='' %}
  mas_labels:
    {{ MAS_LABELS | indent(4) }}
{%- endif %}
{%- if MAS_IMAGE_TAGS is defined and MAS_IMAGE_TAGS !='' %}
  mas_image_tags:
    {{ MAS_IMAGE_TAGS | indent(4) }}
{%- endif %}

{%- if MAS_MANUAL_CERT_MGMT == 'true' and MANUAL_CERT_APP_core == 'true' %}
{%- if MANUAL_CERT_APP_core_HAS_CA == 'true' %}
  ca_cert: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/core#ca_crt>
{%- endif %}
  tls_cert: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/core#tls_crt>
  tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/core#tls_key>
{%- endif %}

{% if MAS_MANUAL_CERT_MGMT == 'true' and (
    MANUAL_CERT_APP_core == 'true' or
    MANUAL_CERT_APP_assist == 'true' or
    MANUAL_CERT_APP_iot == 'true' or
    MANUAL_CERT_APP_manage == 'true' or
    MANUAL_CERT_APP_monitor == 'true' or
    MANUAL_CERT_APP_optimizer == 'true' or
    MANUAL_CERT_APP_predict == 'true' or
    MANUAL_CERT_APP_visualinspection == 'true' or
    MANUAL_CERT_APP_facilities == 'true'
  ) %}
  manual_certs:
{%- if MANUAL_CERT_APP_core == 'true' %}
    core_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/core#tls_crt>
    core_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/core#tls_key>
{%- if MANUAL_CERT_APP_core_HAS_CA == 'true' %}
    core_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/core#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_assist == 'true' %}
    assist_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/assist#tls_crt>
    assist_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/assist#tls_key>
{%- if MANUAL_CERT_APP_assist_HAS_CA == 'true' %}
    assist_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/assist#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_iot == 'true' %}
    iot_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/iot#tls_crt>
    iot_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/iot#tls_key>
{%- if MANUAL_CERT_APP_iot_HAS_CA == 'true' %}
    iot_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/iot#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_manage == 'true' %}
    manage_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/manage#tls_crt>
    manage_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/manage#tls_key>
{%- if MANUAL_CERT_APP_manage_HAS_CA == 'true' %}
    manage_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/manage#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_monitor == 'true' %}
    monitor_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/monitor#tls_crt>
    monitor_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/monitor#tls_key>
{%- if MANUAL_CERT_APP_monitor_HAS_CA == 'true' %}
    monitor_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/monitor#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_optimizer == 'true' %}
    optimizer_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/optimizer#tls_crt>
    optimizer_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/optimizer#tls_key>
{%- if MANUAL_CERT_APP_optimizer_HAS_CA == 'true' %}
    optimizer_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/optimizer#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_predict == 'true' %}
    predict_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/predict#tls_crt>
    predict_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/predict#tls_key>
{%- if MANUAL_CERT_APP_predict_HAS_CA == 'true' %}
    predict_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/predict#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_visualinspection == 'true' %}
    visualinspection_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/visualinspection#tls_crt>
    visualinspection_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/visualinspection#tls_key>
{%- if MANUAL_CERT_APP_visualinspection_HAS_CA == 'true' %}
    visualinspection_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/visualinspection#ca_crt>
{%- endif %}
{%- endif %}
{%- if MANUAL_CERT_APP_facilities == 'true' %}
    facilities_tls_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/facilities#tls_crt>
    facilities_tls_key: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/facilities#tls_key>
{%- if MANUAL_CERT_APP_facilities_HAS_CA == 'true' %}
    facilities_ca_crt: <path:{{ SECRETS_PATH }}:{{ SECRET_NAME_MANUAL_CERTS_PREFIX }}/facilities#ca_crt>
{%- endif %}
{%- endif %}
{% endif %}

{% if MAS_POD_TEMPLATE is defined and MAS_POD_TEMPLATE !='' %}
  mas_pod_templates:
    {{ MAS_POD_TEMPLATE | indent(4) }}
{% endif %}

{% if OIDC_CONFIG_YAML is defined and OIDC_CONFIG_YAML !='' %}
  oidc:
    {{ OIDC_CONFIG_YAML | indent(4) }}
{% endif %}


{% if ALLOW_LIST is defined and ALLOW_LIST != '' %}
  allow_list: {{ALLOW_LIST}}
{% endif %}

{% if SUITE_SPEC_ADDITIONAL_PROPERTIES is defined and SUITE_SPEC_ADDITIONAL_PROPERTIES != '' %}
  suite_spec_additional_properties:
    {{ SUITE_SPEC_ADDITIONAL_PROPERTIES | indent(4) }}
{% endif %}

{% if SUITE_SPEC_SETTINGS_ADDITIONAL_PROPERTIES is defined and SUITE_SPEC_SETTINGS_ADDITIONAL_PROPERTIES != '' %}
  suite_spec_settings_additional_properties:
    {{ SUITE_SPEC_SETTINGS_ADDITIONAL_PROPERTIES | indent(4) }}
{% endif %}

{% if INTERNAL_CERTIFICATE_AUTHORITY is defined and INTERNAL_CERTIFICATE_AUTHORITY != '' %}
  internal_certificate_authority: {{ INTERNAL_CERTIFICATE_AUTHORITY }}
{% endif %}


{% if WELCOME_MESSAGE is defined and WELCOME_MESSAGE != '' %}
  welcome_message: |
    {{ WELCOME_MESSAGE | indent(4) }}
{% endif %}