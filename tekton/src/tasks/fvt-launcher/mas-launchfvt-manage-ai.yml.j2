---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: mas-launchfvt-manage-ai
spec:
  params:
    # Control the image pull policy for the FVT container image
    - name: image_pull_policy
      type: string
      default: IfNotPresent

    - name: pipelinerun_name
      type: string

    - name: aiservice_instance_id
      type: string
      default: ""

  steps:
    # Patch ALM_ENV_FILE on the alm-agent deployment before AI tests run.
    # The alm-agent deployment lives in mas-<instance_id>-core namespace
    # and is named <instance_id>-alm-agent.
    # This step only exists in mas-launchfvt-manage-ai, so it runs
    # exclusively when LAUNCHFVT_MANAGE_AI=true triggers this task.
    - name: patch-alm-agent-env
      image: "quay.io/ibmmas/cli:latest"
      imagePullPolicy: $(params.image_pull_policy)
      script: |
        #!/usr/bin/env bash
        set -e
        ALM_NAMESPACE="mas-${MAS_INSTANCE_ID}-core"
        ALM_DEPLOYMENT="${MAS_INSTANCE_ID}-alm-agent"
        ALM_ENV_VALUE="./.env.fvt"

        echo "Patching ALM_ENV_FILE=${ALM_ENV_VALUE} on deployment/${ALM_DEPLOYMENT} in ${ALM_NAMESPACE}"
        oc set env deployment/${ALM_DEPLOYMENT} \
          ALM_ENV_FILE="${ALM_ENV_VALUE}" \
          -n "${ALM_NAMESPACE}"

        echo "Waiting for rollout to complete..."
        oc rollout status deployment/${ALM_DEPLOYMENT} \
          -n "${ALM_NAMESPACE}" \
          --timeout=300s

        echo "ALM_ENV_FILE patched successfully"
      env:
        - name: MAS_INSTANCE_ID
          valueFrom:
            secretKeyRef:
              name: mas-devops
              key: MAS_INSTANCE_ID
              optional: false

    - name: start-pipelinerun
      image: "quay.io/ibmmas/cli:latest"
      imagePullPolicy: $(params.image_pull_policy)
      command:
        - ansible-playbook
        - /masfvt/fvt-manage-ai.yml
      env:
        - name: IMAGE_PULL_POLICY
          value: $(params.image_pull_policy)
        - name: PIPELINERUN_NAME
          value: $(params.pipelinerun_name)
        - name: PIPELINERUN_NAMESPACE
          value: $(context.taskRun.namespace)
        - name: AISERVICE_INSTANCE_ID
          value: $(params.aiservice_instance_id)

        # Lookups from mas-devops
        # -----------------------------------------------------------------------
        - name: DEVOPS_BUILD_NUMBER
          valueFrom:
            secretKeyRef:
              name: mas-devops
              key: DEVOPS_BUILD_NUMBER
              optional: true
        - name: MAS_INSTANCE_ID
          valueFrom:
            secretKeyRef:
              name: mas-devops
              key: MAS_INSTANCE_ID
              optional: false
        # Service Account for FVT Pipeline (supports RBAC mode)
        - name: SERVICE_ACCOUNT_NAME
          valueFrom:
            secretKeyRef:
              name: mas-devops
              key: SERVICE_ACCOUNT_NAME
              optional: true

        # Lookups from mas-fvt
        # -----------------------------------------------------------------------
        - name: FVT_IMAGE_REGISTRY
          valueFrom:
            secretKeyRef:
              name: mas-fvt
              key: FVT_IMAGE_REGISTRY
              optional: false
        - name: FVT_ARTIFACTORY_USERNAME
          valueFrom:
            secretKeyRef:
              name: mas-fvt
              key: FVT_ARTIFACTORY_USERNAME
              optional: false
        - name: FVT_ARTIFACTORY_TOKEN
          valueFrom:
            secretKeyRef:
              name: mas-fvt
              key: FVT_ARTIFACTORY_TOKEN
              optional: false

        # Lookups from mas-fvt-manage
        # -----------------------------------------------------------------------
        # Framework Information
        - name: MAS_APP_CHANNEL_MANAGE
          valueFrom:
            secretKeyRef:
              name: mas-fvt-manage
              key: MAS_APP_CHANNEL_MANAGE
              optional: false
        - name: MAS_WORKSPACE_ID
          valueFrom:
            secretKeyRef:
              name: mas-fvt-manage
              key: MAS_WORKSPACE_ID
              optional: false
        - name: MANAGE_COMPONENTS
          valueFrom:
            secretKeyRef:
              name: mas-fvt-manage
              key: MANAGE_COMPONENTS
              optional: false
        # Digests
        - name: FVT_DIGEST_MANAGE_PYTEST
          valueFrom:
            secretKeyRef:
              name: mas-fvt-manage
              key: FVT_DIGEST_MANAGE_PYTEST
              optional: false

    - name: wait-for-pipelinerun
      image: "quay.io/ibmmas/cli:latest"
      imagePullPolicy: $(params.image_pull_policy)
      # 50 retries at 10 minute intervals = just over 8 hours
      command:
        - /opt/app-root/src/wait-for-tekton.sh
      env:
        - name: TYPE
          value: pipelinerun
        - name: NAME
          value: $(params.pipelinerun_name)
        - name: SUFFIX
          valueFrom:
            secretKeyRef:
              name: mas-devops
              key: DEVOPS_BUILD_NUMBER
              optional: true
        - name: NAMESPACE
          value: $(context.taskRun.namespace)
        - name: DELAY
          value: "600"
        - name: MAX_RETRIES
          value: "50"
        - name: IGNORE_FAILURE
          value: "True"
