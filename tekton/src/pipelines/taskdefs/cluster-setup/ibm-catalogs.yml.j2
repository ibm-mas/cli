- name: ibm-catalogs
  timeout: "0"
  params:
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/cli-params.yml.j2') | indent(4) }}
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/registry-secret-param.yml.j2') | indent(4) }}
    - name: devops_suite_name
      value: setup-ibm-catalogs

    - name: mas_catalog_version
      value: $(params.mas_catalog_version)

    - name: mas_catalog_digest
      value: $(params.mas_catalog_digest)
  taskRef:
    kind: Task
    name: mas-devops-ibm-catalogs