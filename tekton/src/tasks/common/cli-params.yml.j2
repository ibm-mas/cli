# Common: Control the image pull policy for the CLI container image
- name: image_pull_policy
  type: string
  default: IfNotPresent

# Common: Support for saving task execution results to a MongoDb instance
- name: devops_suite_name
  type: string
  description: Optional name for the junit suite, used to enable save-junit-to-mongo.py
  default: ""

# Common: Pipeline context information (passed from Pipeline)
- name: pipelinerun_namespace
  type: string
  description: Namespace where the pipeline is running
  default: ""
- name: pipelinerun_name
  type: string
  description: Name of the PipelineRun
  default: ""
- name: pipeline_name
  type: string
  description: Name of the Pipeline
  default: ""

# "mas-secrets" as default avoids empty-string secretKeyRef.name which Kubernetes rejects at pod scheduling
# even with optional: true. Taskdefs with registry-secret-param.yml.j2 always override this except FVTs tasks.
- name: task_registry_secret_name
  type: string
  description: Name of the Kubernetes Secret holding pipeline credentials (IBM_ENTITLEMENT_KEY, ARTIFACTORY_TOKEN, ARTIFACTORY_USERNAME)
  default: "mas-secrets"
- name: mas_use_service_mesh
  type: string
  description: Optional string parameter, either true or false (defaults to false), defines whether the suite will be configured to use redhat service mesh for networking
  default: ""

# OLM install plan approval (empty = Automatic, with the mismatch fast-fail active)
- name: olm_approval_mode
  type: string
  description: OLM install plan approval mode (Automatic or Manual); empty defaults to Automatic
  default: ""
- name: olm_approval_timeout
  type: string
  description: Seconds to wait for each individual install plan approval under Manual mode (collection default 7200)
  default: ""
