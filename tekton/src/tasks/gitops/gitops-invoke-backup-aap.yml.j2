---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: gitops-backup-aap
spec:
  params:
    - name: cluster_name
      type: string
    - name: account
      type: string
    - name: mas_instance_id
      type: string
    - name: region_name
      type: string
      default: ""
    - name: backup_enabled
      type: string
      default: 'false'
    - name: restore_enabled
      type: string
      default: 'false'
    - name: catalog_build_id
      type: string
      default: ""
    - name: catalog_version
      type: string
      default: ""
    - name: atlas_cluster_name
      type: string
      default: ""
    - name: atlas_project_id
      type: string
      default: ""
    - name: db2u_config
      type: string
      default: ""
    - name: sls_service
      type: string
      default: ""

  stepTemplate:
    env:
      - name: CLUSTER_NAME
        value: $(params.cluster_name)
      - name: ACCOUNT
        value: $(params.account)
      - name: MAS_INSTANCE_ID
        value: $(params.mas_instance_id)
      - name: REGION_NAME
        value: $(params.region_name)
      - name: BACKUP_ENABLED
        value: $(params.backup_enabled)
      - name: RESTORE_ENABLED
        value: $(params.restore_enabled)
      - name: CATALOG_BUILD_ID
        value: $(params.catalog_build_id)
      - name: CATALOG_VERSION
        value: $(params.catalog_version)
      - name: ATLAS_CLUSTER_NAME
        value: $(params.atlas_cluster_name)
      - name: ATLAS_PROJECT_ID
        value: $(params.atlas_project_id)
      - name: DB2U_CONFIG
        value: $(params.db2u_config)
      - name: SLS_SERVICE
        value: $(params.sls_service)
    envFrom:
      - configMapRef:
          name: environment-properties
          optional: true
      - secretRef:
          name: secure-properties

  steps:
    - name: invoke-backup-aap
      args:
        - |-
          mkdir -p /workspace/gitops-invoke-backup-aap

          # Invoke the backup AAP job (AAP_* settings and ATLAS_PUBLIC_KEY/ATLAS_PRIVATE_KEY come from secure-properties)
          mas gitops-invoke-backup-aap \
            -a "$ACCOUNT" \
            -c "$CLUSTER_NAME" \
            -m "$MAS_INSTANCE_ID" \
            --region-name "$REGION_NAME" \
            --backup-enabled "$BACKUP_ENABLED" \
            --restore-enabled "$RESTORE_ENABLED" \
            --catalog-build-id "$CATALOG_BUILD_ID" \
            --catalog-version "$CATALOG_VERSION" \
            --atlas-cluster-name "$ATLAS_CLUSTER_NAME" \
            --atlas-project-id "$ATLAS_PROJECT_ID" \
            --db2u-config "$DB2U_CONFIG" \
            --sls-service "$SLS_SERVICE" \
            --dir /workspace/gitops-invoke-backup-aap

          exit $?
      command:
        - /bin/sh
        - -c
      imagePullPolicy: IfNotPresent
      image: "quay.io/ibmmas/cli:latest"

  workspaces:
    - name: configs
      mountPath: /workspace/gitops-invoke-backup-aap