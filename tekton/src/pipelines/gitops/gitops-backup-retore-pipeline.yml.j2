apiVersion: tekton.dev/v1
kind: Pipeline
metadata:
  name: gitops-backup-restore-pipeline
spec:
  params:
    - name: cluster_name
      type: string
    - name: account
      type: string
    - name: mas_instance_id
      type: string
    - name: cluster_url
      type: string
    - name: region_name
      type: string
    - name: backup_enabled
      type: string
      default: 'false'
    - name: restore_enabled
      type: string
      default: 'false'
    - name: iam_user_name
      type: string
      default: ""
    - name: sync_to_test_framework
      type: string
      default: 'false'
    - name: backup_retention_profile
      type: string
      default: ""
    - name: backup_release_tag
      type: string
      default: ""
    - name: backup_ticket_id
      type: string
      default: ""
    - name: catalog_build_id
      type: string
      default: ""
    - name: atlas_restore_databases
      type: string
      default: ""


  workspaces:
    - name: configs
    - name: shared-gitops-configs

  tasks:

    # Task 1: Invoke Backup AAP
    # -------------------------------------------------------------------------
    - name: gitops-backup-aap
      when:
        - input: "$(params.backup_enabled)"
          operator: in
          values: ["true"]
      taskRef:
        name: gitops-backup-aap
      workspaces:
        - name: configs
          workspace: configs
      params:
        - name: cluster_name
          value: $(params.cluster_name)
        - name: account
          value: $(params.account)
        - name: mas_instance_id
          value: $(params.mas_instance_id)
        - name: region_name
          value: $(params.region_name)
        - name: backup_enabled
          value: $(params.backup_enabled)
        - name: restore_enabled
          value: $(params.restore_enabled)
        - name: iam_user_name
          value: $(params.iam_user_name)
        - name: sync_to_test_framework
          value: $(params.sync_to_test_framework)
        - name: backup_retention_profile
          value: $(params.backup_retention_profile)
        - name: backup_release_tag
          value: $(params.backup_release_tag)
        - name: backup_ticket_id
          value: $(params.backup_ticket_id)
        - name: catalog_build_id
          value: $(params.catalog_build_id)
        - name: atlas_restore_databases
          value: $(params.atlas_restore_databases)


    # Task 2: Invoke Restore AAP
    # -------------------------------------------------------------------------
    - name: gitops-restore-aap
      when:
        - input: "$(params.restore_enabled)"
          operator: in
          values: ["true"]
      taskRef:
        name: gitops-backup-aap
      workspaces:
        - name: configs
          workspace: configs
      params:
        - name: cluster_name
          value: $(params.cluster_name)
        - name: account
          value: $(params.account)
        - name: mas_instance_id
          value: $(params.mas_instance_id)
        - name: cluster_url
          value: $(params.cluster_url)
        - name: region_name
          value: $(params.region_name)
        - name: backup_enabled
          value: $(params.backup_enabled)
        - name: restore_enabled
          value: $(params.restore_enabled)
        - name: iam_user_name
          value: $(params.iam_user_name)
        - name: sync_to_test_framework
          value: $(params.sync_to_test_framework)
        - name: backup_retention_profile
          value: $(params.backup_retention_profile)
        - name: backup_release_tag
          value: $(params.backup_release_tag)
        - name: backup_ticket_id
          value: $(params.backup_ticket_id)
        - name: catalog_build_id
          value: $(params.catalog_build_id)
        - name: atlas_restore_databases
          value: $(params.atlas_restore_databases)
