---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: mas-devops-rhoai-migration
spec:
  params:
    {{ lookup('template', task_src_dir ~ '/common/cli-params.yml.j2') | indent(4) }}

    # RHOAI subscription channel
    - name: rhoai_channel
      type: string
      description: Subscription channel for RHOAI (empty to use the aiservice_rhoai role default)
      default: ""

  steps:
    - name: rhoai-migration
      image: "quay.io/ibmmas/cli:latest"
      imagePullPolicy: $(params.image_pull_policy)
      command:
        - /opt/app-root/src/run-role.sh
        - aiservice_rhoai
      workingDir: /workspace/configs
      env:
        {{ lookup('template', task_src_dir ~ '/common/cli-env.yml.j2') | indent(8) }}

        # RHOAI subscription channel
        - name: RHOAI_CHANNEL
          value: $(params.rhoai_channel)
