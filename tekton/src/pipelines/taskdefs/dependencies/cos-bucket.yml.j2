- name: cos-bucket-{{ suffix }}
  timeout: "0"
  params:
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/cli-params.yml.j2') | indent(4) }}
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/registry-secret-param.yml.j2') | indent(4) }}
    - name: devops_suite_name
      value: dependencies-cos-bucket-{{ suffix }}
    - name: cos_type
      value: odf
    - name: cos_bucket_name
      value: {{ bucket_name }}
    - name: cos_bucket_action
      value: create

  taskRef:
    kind: Task
    name: mas-devops-cos-bucket

  # Only create the Ceph (ODF) buckets if Ceph is requested
  when:
    - input: "$(params.install_ceph)"
      operator: in
      values: ["true", "True"]
  workspaces:
    - name: configs
      workspace: shared-configs
