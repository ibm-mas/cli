---
apiVersion: tekton.dev/v1
kind: Pipeline
metadata:
  name: gitops-test-recorder-pipeline
spec:
  description: >
    Records a new parent collection document in MongoDB for a promoted catalog
    build across all registered SaaS staging instances.  Triggered by the
    pipeline launcher when catalog.build_id changes in a cluster-params.yaml.
  workspaces:
    - name: pipeline-pvc
  params:
    - name: catalog_version
      type: string
      description: "Catalog version string e.g. v9-260827-amd64"
    - name: catalog_image
      type: string
      description: "Full catalog image path"
    - name: build_id
      type: string
      description: "Numeric build identifier"
    - name: github_host
      type: string
      description: "GitHub host"
      default: "github.ibm.com"
    - name: github_org
      type: string
      description: "GitHub organization"
      default: "maximoappsuite"
    - name: github_repo
      type: string
      description: "GitHub repository"
      default: "saas-envs"
    - name: git_branch
      type: string
      description: "Branch of the repo to clone"
      default: "dev"
    - name: instance_registry_file
      type: string
      description: "Relative path within the cloned repo to the instance registry YAML"
      default: "gitops/aws-stg/instance-registry.yaml"
  tasks:
    - name: record-build-collection
      taskRef:
        name: gitops-test-recorder
      workspaces:
        - name: task-pvc
          workspace: pipeline-pvc
      params:
        - name: catalog_version
          value: $(params.catalog_version)
        - name: catalog_image
          value: $(params.catalog_image)
        - name: build_id
          value: $(params.build_id)
        - name: github_host
          value: $(params.github_host)
        - name: github_org
          value: $(params.github_org)
        - name: github_repo
          value: $(params.github_repo)
        - name: git_branch
          value: $(params.git_branch)
        - name: instance_registry_file
          value: $(params.instance_registry_file)
