# Common Parameters
# -------------------------------------------------------------------------
# Tekton Pipeline image pull policy (for ibmmas/cli images)
- name: image_pull_policy
  type: string
  default: IfNotPresent
  description: Pull policy for pipeline container images

# Registry Credentials Secret
# "mas-secrets" as default avoids empty-string secretKeyRef.name which Kubernetes rejects at pod scheduling
# even with optional: true. Taskdefs with registry-secret-param.yml.j2 always override this except FVTs tasks.
- name: pipeline_registry_secret_name
  type: string
  default: "mas-secrets"
  description: Name of the per-pipeline Kubernetes Secret holding registry credentials (IBM_ENTITLEMENT_KEY, ARTIFACTORY_TOKEN, ARTIFACTORY_USERNAME)

# Custom Labels
- name: custom_labels
  type: string
  default: ""
  description: Optional custom labels, comma separated list of key=value pairs

# Slack Notifications
- name: slack_token
  type: string
  default: ""
  description: Slack bot token for sending pipeline notifications
- name: slack_channel
  type: string
  default: ""
  description: Slack channel(s) for notifications (comma-separated for multiple channels)

# OLM install plan approval: "Manual" pauses roles at every install plan awaiting
# human approval (see the ansible-devops OLM manual approvals documentation). Empty
# = Automatic (the collection treats an empty env value as unset, which resolves
# to Automatic with the approval mode mismatch fast-fail active by default).
- name: olm_approval_mode
  type: string
  default: ""
  description: OLM install plan approval mode (Automatic or Manual); empty defaults to Automatic
- name: olm_approval_timeout
  type: string
  default: ""
  description: Seconds to wait for each individual install plan approval under Manual mode (collection default 7200)

{% if application is not defined %}

# MAS Configuration
- name: mas_channel
  type: string
  default: ""
- name: mas_instance_id
  type: string
  default: ""
{% endif %}
