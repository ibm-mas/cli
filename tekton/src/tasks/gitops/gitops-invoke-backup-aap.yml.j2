---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: gitops-backup-aap
spec:
  params:
    - name: cluster_name
      type: string
    - name: account
      type: string
    - name: mas_instance_id
      type: string
    - name: region_name
      type: string
      default: ""
    - name: backup_enabled
      type: string
      default: 'false'
    - name: restore_enabled
      type: string
      default: 'false'
    - name: iam_user_name
      type: string
      default: ""
    - name: avp_aws_secret_region
      type: string
    - name: sync_to_test_framework
      type: string
      default: 'false'
    - name: backup_retention_profile
      type: string
      default: ""
    - name: backup_release_tag
      type: string
      default: ""
    - name: backup_ticket_id
      type: string
      default: ""
    - name: catalog_build_id
      type: string
      default: ""
    - name: atlas_restore_databases
      type: string
      default: ""

  stepTemplate:
    env:
      - name: CLUSTER_NAME
        value: $(params.cluster_name)
      - name: ACCOUNT
        value: $(params.account)
      - name: MAS_INSTANCE_ID
        value: $(params.mas_instance_id)
      - name: REGION_NAME
        value: $(params.region_name)
      - name: BACKUP_ENABLED
        value: $(params.backup_enabled)
      - name: RESTORE_ENABLED
        value: $(params.restore_enabled)
      - name: IAM_USER_NAME
        value: $(params.iam_user_name)
      - name: SM_AWS_REGION
        value: $(params.avp_aws_secret_region)
      - name: SYNC_TO_TEST_FRAMEWORK
        value: $(params.sync_to_test_framework)
      - name: BACKUP_RETENTION_PROFILE
        value: $(params.backup_retention_profile)
      - name: BACKUP_RELEASE_TAG
        value: $(params.backup_release_tag)
      - name: BACKUP_TICKET_ID
        value: $(params.backup_ticket_id)
      - name: CATALOG_BUILD_ID
        value: $(params.catalog_build_id)
      - name: ATLAS_RESTORE_DATABASES
        value: $(params.atlas_restore_databases)
    envFrom:
      - configMapRef:
          name: environment-properties
          optional: true
      - secretRef:
          name: secure-properties

  steps:
    - name: invoke-backup-aap
      args:
        - |-
          mkdir -p /workspace/gitops-invoke-backup-aap

          # Invoke the backup AAP job (AAP_* settings and ATLAS_PUBLIC_KEY/ATLAS_PRIVATE_KEY come from secure-properties)
          mas gitops-invoke-backup-aap \
            -a "$ACCOUNT" \
            -c "$CLUSTER_NAME" \
            -m "$MAS_INSTANCE_ID" \
            --region-name "$REGION_NAME" \
            --backup-enabled "$BACKUP_ENABLED" \
            --restore-enabled "$RESTORE_ENABLED" \
            --iam-user-name "$IAM_USER_NAME" \
            --sync-to-test-framework "$SYNC_TO_TEST_FRAMEWORK" \
            --backup-retention-profile "$BACKUP_RETENTION_PROFILE" \
            --backup-release-tag "$BACKUP_RELEASE_TAG" \
            --backup-ticket-id "$BACKUP_TICKET_ID" \
            --catalog-build-id "$CATALOG_BUILD_ID" \
            --atlas-restore-databases "$ATLAS_RESTORE_DATABASES" \
            --dir /workspace/gitops-invoke-backup-aap

          exit $?
      command:
        - /bin/sh
        - -c
      imagePullPolicy: IfNotPresent
      image: "quay.io/ibmmas/cli:latest"

  workspaces:
    - name: configs
      mountPath: /workspace/gitops-invoke-backup-aap