---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: mas-fvt-start-backup
spec:
  params:
    {{ lookup('template', task_src_dir ~ '/common/cli-params.yml.j2') | indent(4) }}
    - name: mas_instance_id
      type: string
      description: Instance ID
    - name: backup_manage_app
      type: string
      description: "Set to 'true' to include the Manage application and its Db2 database in the backup"
      default: "false"

  volumes:
    - name: mas-fvt-backup
      secret:
        secretName: mas-fvt-backup
        optional: false

  steps:
    - name: start-backup
      volumeMounts:
        - name: mas-fvt-backup
          mountPath: /etc/mas-fvt-backup
          readOnly: true
      script: |
        #!/usr/bin/env bash
        set -e

        BACKUP_FLAGS=(
          --instance-id "$MAS_INSTANCE_ID"
          --upload-backup
          --artifactory-url "$ARTIFACTORY_URL"
          --artifactory-repository "$ARTIFACTORY_REPOSITORY"
          --artifactory-username "$ARTIFACTORY_USERNAME"
          --artifactory-token "$ARTIFACTORY_TOKEN"
          --dev-mode
          --no-confirm
        )

        if [[ "$BACKUP_MANAGE_APP" == "true" || "$BACKUP_MANAGE_APP" == "True" ]]; then
          BACKUP_FLAGS+=(
            --backup-manage-app
            --backup-manage-db
          )
        fi

        mas backup "${BACKUP_FLAGS[@]}"

        RESULT=$?
        echo 'MAS LOG'
        echo '--------------------------------------------------------------------------------'
        cat mas.log
        echo '--------------------------------------------------------------------------------'
        exit $RESULT
      timeout: "0"
      image: "quay.io/ibmmas/cli:latest"
      imagePullPolicy: $(params.image_pull_policy)
      env:
        {{ lookup('template', task_src_dir ~ '/common/cli-env.yml.j2') | indent(8) }}
        - name: MAS_INSTANCE_ID
          value: $(params.mas_instance_id)
        - name: BACKUP_MANAGE_APP
          value: $(params.backup_manage_app)
        - name: ARTIFACTORY_URL
          valueFrom:
            secretKeyRef:
              name: mas-fvt-backup
              key: ARTIFACTORY_URL
        - name: ARTIFACTORY_REPOSITORY
          valueFrom:
            secretKeyRef:
              name: mas-fvt-backup
              key: ARTIFACTORY_REPOSITORY
        - name: ARTIFACTORY_USERNAME
          valueFrom:
            secretKeyRef:
              name: mas-fvt-backup
              key: ARTIFACTORY_USERNAME
        - name: ARTIFACTORY_TOKEN
          valueFrom:
            secretKeyRef:
              name: mas-fvt-backup
              key: ARTIFACTORY_TOKEN
