- name: {{ name | default("ocp-verify") }}
  timeout: "0"
  taskRef:
    kind: Task
    name: mas-devops-ocp-verify-all
  params:
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/cli-params.yml.j2') | indent(4) }}
    {{ lookup('template', pipeline_src_dir ~ '/taskdefs/common/registry-secret-param.yml.j2') | indent(4) }}
    # Pipeline Config
    - name: skip_pre_check
      value: $(params.skip_pre_check)
    - name: devops_suite_name
      value: {{ devops_suite_name }}
    # OLM approval gate (False everywhere except the update pipeline's
    # post-update-verify, where waiting for manual approvals is the job)
    - name: verify_subscription_approvals
      value: "{{ verify_subscription_approvals | default('False') }}"
  when:
    - input: "$(params.skip_pre_check)"
      operator: notin
      values: ["True", "true"]
