# Controls the image pull policy for the ibmmas/cli image
- name: image_pull_policy
  value: $(params.image_pull_policy)

# OLM install plan approval (empty = Automatic)
- name: olm_approval_mode
  value: $(params.olm_approval_mode)
- name: olm_approval_timeout
  value: $(params.olm_approval_timeout)

# Pipeline context information
- name: pipelinerun_namespace
  value: $(context.pipelineRun.namespace)
- name: pipelinerun_name
  value: $(context.pipelineRun.name)
- name: pipeline_name
  value: $(context.pipeline.name)
